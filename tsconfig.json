{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "packages",
    "paths": { "@pi-swarm/core": ["./packages/runtime/core/src/index.ts"] },
    "types": ["node"]
  },
  "include": ["packages/**/src/**/*.ts"],
  "exclude": ["**/node_modules/**", "**/dist/**", "**/test/**"]
}
